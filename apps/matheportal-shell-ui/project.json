{
    "name": "matheportal-shell-ui",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "prefix": "portal",
    "sourceRoot": "apps/matheportal-shell-ui/src",
    "tags": [],
    "targets": {
        "build": {
            "executor": "@angular-architects/native-federation:build",
            "options": {},
            "configurations": {
                "production": {
                    "target": "matheportal-shell-ui:esbuild:production"
                },
                "development": {
                    "target": "matheportal-shell-ui:esbuild:development",
                    "dev": true
                }
            },
            "defaultConfiguration": "production"
        },
        "serve": {
            "executor": "@angular-architects/native-federation:build",
            "options": {
                "target": "matheportal-shell-ui:serve-original:development",
                "rebuildDelay": 500,
                "dev": true,
                "cacheExternalArtifacts": false,
                "port": 0
            },
            "continuous": true
        },
        "lint": {
            "executor": "@nx/eslint:lint"
        },
        "serve-static": {
            "continuous": true,
            "executor": "@nx/web:file-server",
            "options": {
                "buildTarget": "matheportal-shell-ui:build",
                "port": 4200,
                "staticFilePath": "dist/apps/matheportal-shell-ui/browser",
                "spa": true
            }
        },
        "esbuild": {
            "executor": "@angular/build:application",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/apps/matheportal-shell-ui",
                "browser": "apps/matheportal-shell-ui/src/main.ts",
                "tsConfig": "apps/matheportal-shell-ui/tsconfig.app.json",
                "inlineStyleLanguage": "scss",
                "assets": [
                    {
                        "glob": "**/*",
                        "input": "apps/matheportal-shell-ui/public"
                    }
                ],
                "styles": ["apps/matheportal-shell-ui/src/styles.scss"],
                "polyfills": ["es-module-shims"]
            },
            "configurations": {
                "production": {
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "500kb",
                            "maximumError": "1mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "4kb",
                            "maximumError": "8kb"
                        }
                    ],
                    "outputHashing": "all"
                },
                "development": {
                    "optimization": false,
                    "extractLicenses": false,
                    "sourceMap": true
                }
            },
            "defaultConfiguration": "production"
        },
        "serve-original": {
            "continuous": true,
            "executor": "@angular/build:dev-server",
            "configurations": {
                "production": {
                    "buildTarget": "matheportal-shell-ui:esbuild:production"
                },
                "development": {
                    "buildTarget": "matheportal-shell-ui:esbuild:development"
                }
            },
            "defaultConfiguration": "development",
            "options": {
                "port": 4200
            }
        }
    }
}
