{
    "name": "matheportal-shell",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/matheportal-shell/src",
    "tags": ["platform:backend", "type:bff"],
    "implicitDependencies": ["matheportal-bom", "auth-session"],

    "targets": {
        "tech-generate-sources": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "apps/matheportal-shell",
                "command": "mvn clean generate-sources"
            }
        },
        "tech-dev": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "apps/matheportal-shell",
                "command": "mvn clean quarkus:dev",
                "envFile": "apps/matheportal-shell/.config/.env.dev"
            }
        },
        "tech-debug": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "apps/matheportal-shell",
                "command": "mvn quarkus:dev -Ddebug=5005",
                "envFile": "apps/matheportal-shell/.config/.env.dev"
            }
        },
        "serve-dev": {
            "executor": "nx:run-commands",
            "options": {
                "parallel": true,
                "commands": [
                    "npx nx run matheportal-shell-ui:tech-serve-federation-dev",
                    "npx nx run matheportal-shell:tech-dev"
                ]
            }
        },
        "serve-debug": {
            "executor": "nx:run-commands",
            "options": {
                "parallel": true,
                "commands": [
                    "npx nx run matheportal-shell-ui:tech-serve-federation-dev",
                    "npx nx run matheportal-shell:tech-debug"
                ]
            }
        },
        "test": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "apps/matheportal-shell",
                "command": "mvn test -Ptesting-coverage-reportOnly",
                "envFile": "apps/matheportal-shell/.config/.env.test"
            }
        },
        "cleanup": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "apps/matheportal-shell",
                "command": "mvn -Pformat-apply impsort:sort@impsort-sort formatter:format@format-apply"
            }
        },
        "analyze-quality": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "apps/matheportal-shell",
                "command": "mvn -DskipTests -Panalyze-linting-strict,analyze-javadoc-strict,analyze-quality-strict clean verify"
            }
        },
        "analyze-cve": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "apps/matheportal-shell",
                "command": "mvn -DskipTests -Dnvd.api.key=${NVD_API_KEY} -DnvdApiDelay=8000 -Panalyze-securityScan verify"
            }
        },
        "tech-embed-frontend": {
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": ["matheportal-shell-ui"],
                    "target": "tech-prepare-runtime-config",
                    "params": "forward"
                }
            ],
            "options": {
                "parallel": false,
                "commands": [
                    "rm -rf apps/matheportal-shell/src/main/resources/META-INF/resources/matheportal-shell",
                    "mkdir -p apps/matheportal-shell/src/main/resources/META-INF/resources/matheportal-shell",
                    "rsync -a --delete /home/heike/git/matheportal/dist/apps/matheportal-shell-ui/browser/ apps/matheportal-shell/src/main/resources/META-INF/resources/matheportal-shell/"
                ]
            },
            "configurations": {
                "local": {},
                "qs": {},
                "production": {}
            }
        },
        "serve-embedded": {
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": "self",
                    "target": "tech-embed-frontend",
                    "params": "forward"
                }
            ],
            "options": {
                "cwd": "apps/matheportal-shell",
                "command": "mvn quarkus:dev",
                "envFile": "apps/matheportal-shell/.config/.env.dev-embedded"
            },
            "configurations": {
                "development": {}
            },
            "defaultConfiguration": "development",
            "continuous": true
        },
        "tech-package": {
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "target": "install",
                    "projects": "dependencies"
                },
                {
                    "projects": "self",
                    "target": "tech-embed-frontend",
                    "params": "forward"
                }
            ],
            "outputs": ["{workspaceRoot}/apps/matheportal-shell/target"],
            "options": {
                "cwd": "apps/matheportal-shell",
                "command": "mvn clean package -DskipTests"
            }
        },
        "prepare-deployment": {
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": "self",
                    "target": "tech-package",
                    "params": "forward"
                }
            ],
            "options": {
                "parallel": false,
                "commands": [
                    "rm -rf /home/heike/deployments/x300-heikeqs/matheportal/matheportal-shell/quarkus-app",
                    "mv apps/matheportal-shell/target/quarkus-app /home/heike/deployments/x300-heikeqs/matheportal/matheportal-shell"
                ]
            },
            "configurations": {
                "qs": {
                    "commands": [
                        "rm -rf /home/heike/deployments/x300-heikeqs/matheportal/matheportal-shell/quarkus-app",
                        "mv apps/matheportal-shell/target/quarkus-app /home/heike/deployments/x300-heikeqs/matheportal/matheportal-shell"
                    ]
                },
                "production": {
                    "commands": [
                        "rm -rf /home/heike/deployments/vserver1/matheportal/matheportal-shell/quarkus-app",
                        "mv apps/matheportal-shell/target/quarkus-app /home/heike/deployments/vserver1/matheportal/matheportal-shell"
                    ]
                }
            }
        }
    }
}
