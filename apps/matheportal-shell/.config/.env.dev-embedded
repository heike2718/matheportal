QUARKUS_HTTP_CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202,http://localhost:9100,http://localhost:9101,http://localhost:9102

#=================================================================#
# Session
#=================================================================#

SESSION_COOKIE_NAME=MPSESSIONID
SESSION_COOKIE_PATH=/
SESSION_COOKIE_SECURE=false

#=================================================================#
# authprovider, Redirect URLs, REST-Client, CORS
#
# PUBLIC_REDIRECT_URL muss ohne http:// und endenden / in
# CLIENTS.REDIRECT_URLS vorkommen!! Für das korrekte redirect
# sollten sie aber u.U. vorhanden sein.
#
#=================================================================#
CLIENT_ID=matheportalShellClient
CLIENT_SECRET=start123

MP_JWT_VERIFY_PUBLICKEY_LOCATION=classpath:keys/authprov_public_key.pem

AUTH_APP_URL=http://localhost:9000/authprovider/
CLIENT_REDIRECT_URL=http://localhost:9100/matheportal/
QUARKUS_REST_CLIENT_AUTHPROVIDER_URL=http://localhost:9000
AUTHPROVIDER_URL=http://localhost:9000/authprovider


# --------------------------------------------------------------------------------
#           database
# --------------------------------------------------------------------------------
QUARKUS_DATASOURCE_SESSIONS_JDBC_URL=jdbc:mariadb://172.18.0.2:3306/matheportal_sessions
QUARKUS_DATASOURCE_SESSIONS_PASSWORD=hwinkel

# --------------------------------------------------------------------------------
#           logging
# --------------------------------------------------------------------------------
QUARKUS_LOG_FILE_ENABLED=false
QUARKUS_HTTP_ACCESS_LOG_LOG_TO_FILE=false

QUARKUS_HTTP_TEST_TIMEOUT=120s
