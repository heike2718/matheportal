{
    "name": "raetselbaukasten-ui",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "prefix": "rbk",
    "sourceRoot": "apps/raetselbaukasten-ui/src",
    "tags": ["type:app", "scope:raetselbaukasten", "layer:remote"],
    "targets": {
        "tech-build": {
            "executor": "@angular-architects/native-federation:build",
            "options": {
                "baseHref": "/raetselbaukasten/",
                "output-hashing": "all"
            },
            "configurations": {
                "production": {
                    "target": "raetselbaukasten-ui:tech-esbuild:production",
                    "fileReplacements": [
                        {
                            "replace": "src/app/config/configuration.ts",
                            "with": "src/app/config/configuration.production.ts"
                        }
                    ]
                },
                "qs": {
                    "target": "raetselbaukasten-ui:tech-esbuild:qs",
                    "fileReplacements": [
                        {
                            "replace": "src/app/config/configuration.ts",
                            "with": "src/app/config/configuration.qs.ts"
                        }
                    ]
                },
                "local": {
                    "target": "raetselbaukasten-ui:tech-esbuild:development",
                    "dev": true
                },
                "development": {
                    "target": "raetselbaukasten-ui:tech-esbuild:development",
                    "dev": true
                }
            },
            "defaultConfiguration": "development"
        },
        "tech-serve-angular-dev": {
            "continuous": true,
            "executor": "@angular/build:dev-server",
            "options": {
                "buildTarget": "raetselbaukasten-ui:tech-esbuild:development",
                "port": 4202
            }
        },
        "tech-serve-federation-dev": {
            "executor": "@angular-architects/native-federation:build",
            "options": {
                "target": "raetselbaukasten-ui:tech-serve-angular-dev",
                "rebuildDelay": 500,
                "dev": true,
                "cacheExternalArtifacts": false,
                "port": 0
            },
            "continuous": true
        },
        "tech-esbuild": {
            "executor": "@angular/build:application",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/apps/raetselbaukasten-ui",
                "browser": "apps/raetselbaukasten-ui/src/main.ts",
                "tsConfig": "apps/raetselbaukasten-ui/tsconfig.app.json",
                "inlineStyleLanguage": "scss",
                "stylePreprocessorOptions": { "includePaths": ["libs/shared-ui-theme/src/lib/styles"] },
                "assets": [
                    {
                        "glob": "**/*",
                        "input": "apps/raetselbaukasten-ui/public"
                    }
                ],
                "styles": [
                    "apps/raetselbaukasten-ui/src/styles.scss",
                    "node_modules/material-icons/iconfont/material-icons.css"
                ],
                "polyfills": ["es-module-shims"]
            },
            "configurations": {
                "production": {
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "500kb",
                            "maximumError": "1mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "4kb",
                            "maximumError": "8kb"
                        }
                    ],
                    "outputHashing": "all"
                },
                "qs": {
                    "optimization": true,
                    "extractLicenses": true,
                    "sourceMap": false,
                    "outputHashing": "all"
                },
                "development": {
                    "optimization": false,
                    "extractLicenses": false,
                    "sourceMap": true
                },
                "test": {
                    "sourceMap": true,
                    "optimization": false,
                    "polyfills": []
                }
            },
            "defaultConfiguration": "development"
        },
        "test": {
            "executor": "@angular/build:unit-test",
            "options": {
                "tsConfig": "apps/raetselbaukasten-ui/tsconfig.spec.json",
                "buildTarget": "raetselbaukasten-ui:tech-esbuild:test",
                "runner": "vitest",
                "watch": false
            }
        },
        "tech-format": {
            "executor": "nx:run-commands",
            "options": {
                "command": "prettier --write \"{projectRoot}/src/**/*.{ts,html,scss}\" --ignore-path .prettierignore"
            }
        },
        "tech-format-check": {
            "executor": "nx:run-commands",
            "options": {
                "command": "prettier --check \"{projectRoot}/src/**/*.{ts,html,scss}\" --ignore-path .prettierignore"
            }
        },
        "tech-lint": {
            "executor": "@nx/eslint:lint"
        },
        "tech-lint-fix": {
            "executor": "@nx/eslint:lint",
            "options": {
                "fix": true
            }
        },
        "cleanup": {
            "executor": "nx:run-commands",
            "dependsOn": ["tech-lint-fix", "tech-format"],
            "options": {
                "command": "true"
            }
        },
        "analyze-quality": {
            "executor": "nx:run-commands",
            "dependsOn": ["tech-lint", "tech-format-check"],
            "options": {
                "command": "true"
            }
        }
    }
}
