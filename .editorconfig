# Editor configuration, see http://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
tab_width = 4

[*.java]
# Verhindert, dass EditorConfig die Einrückung des XML-Formatierers überschreibt
indent_style = unset
indent_size = unset
tab_width = unset