{
    "name": "@matheportal/source",
    "version": "0.0.0",
    "license": "MIT",
    "scripts": {
        "check-node": "node -e \"if(!process.version.startsWith('v22.')){console.error('\\n❌ Node 22 required. Current:',process.version,'\\n');process.exit(1)}\"",
        "preinstall": "pnpm run -s check-node",
        "shell:dev:be": "nx run matheportal-shell:dev",
        "cleanup:all": "nx run-many -t cleanup --projects=matheportal-shell-ui,raetselbaukasten-ui,minikaenguru-anwendung-ui,matheportal-shell,raetselbaukasten,minikaenguru-anwendung",
        "format-check:fe:all": "pnpm nx run-many -t format-check --projects=matheportal-shell-ui,raetselbaukasten-ui,minikaenguru-anwendung-ui",
        "lint:fe:all": "pnpm nx run-many -t lint --projects=matheportal-shell-ui,raetselbaukasten-ui,minikaenguru-anwendung-ui",
        "test:fe:all": "pnpm nx run-many -t test --projects=matheportal-shell-ui,raetselbaukasten-ui,minikaenguru-anwendung-ui --watch=false",
        "test:be:all": "pnpm nx run-many -t test --projects=matheportal-shell,raetselbaukasten,minikaenguru-anwendung",
        "check:all": "pnpm run format-check:fe:all && pnpm run lint:fe:all && pnpm run test:fe:all && pnpm run test:be:all"
    },
    "engines": {
        "node": ">=22.17.0 <23",
        "pnpm": ">=10 <11"
    },
    "private": true,
    "dependencies": {
        "@angular-architects/native-federation": "^21.2.3",
        "@angular/animations": "~21.2.0",
        "@angular/common": "~21.2.0",
        "@angular/compiler": "~21.2.0",
        "@angular/core": "~21.2.0",
        "@angular/forms": "~21.2.0",
        "@angular/platform-browser": "~21.2.0",
        "@angular/router": "~21.2.0",
        "@softarc/native-federation-node": "^3.3.4",
        "es-module-shims": "^1.5.12",
        "rxjs": "~7.8.0"
    },
    "devDependencies": {
        "22.6.3": "link:@nx/angular/22.6.3",
        "@angular-devkit/build-angular": "~21.2.0",
        "@angular-devkit/core": "~21.2.0",
        "@angular-devkit/schematics": "~21.2.0",
        "@angular/build": "~21.2.0",
        "@angular/cli": "~21.2.0",
        "@angular/compiler-cli": "~21.2.0",
        "@angular/language-service": "~21.2.0",
        "@eslint/js": "^9.8.0",
        "@nx/angular": "22.6.3",
        "@nx/devkit": "22.6.3",
        "@nx/eslint": "22.6.3",
        "@nx/eslint-plugin": "22.6.3",
        "@nx/js": "22.6.3",
        "@nx/playwright": "22.6.3",
        "@nx/vite": "22.6.3",
        "@nx/web": "22.6.3",
        "@nx/workspace": "22.6.3",
        "@oxc-project/runtime": "^0.115.0",
        "@playwright/test": "^1.36.0",
        "@schematics/angular": "~21.2.0",
        "@swc-node/register": "~1.11.1",
        "@swc/core": "~1.15.5",
        "@swc/helpers": "~0.5.18",
        "@typescript-eslint/utils": "^8.40.0",
        "angular-eslint": "^21.2.0",
        "eslint": "^9.8.0",
        "eslint-config-prettier": "^10.0.0",
        "eslint-plugin-playwright": "^1.6.2",
        "jsdom": "^27.1.0",
        "nx": "22.6.3",
        "prettier": "~3.6.2",
        "tslib": "^2.3.0",
        "typescript": "~5.9.2",
        "typescript-eslint": "^8.40.0",
        "vitest": "^4.0.8"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "less",
            "@parcel/watcher",
            "nx"
        ]
    }
}
