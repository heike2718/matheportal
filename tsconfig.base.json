{
    "compileOnSave": false,
    "compilerOptions": {
        "rootDir": ".",
        "sourceMap": true,
        "declaration": false,
        "moduleResolution": "node",
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "importHelpers": true,
        "target": "es2015",
        "module": "esnext",
        "lib": ["es2020", "dom"],
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@matheportal-shell-config": ["./apps/matheportal-shell-ui/src/app/config/index.ts"],
            "@matheportal/shared-runtime-config": ["libs/shared-runtime-config/src/index.ts"],
            "@matheportal/shared-testing": ["libs/testing/src/index.ts"],
            "@matheportal/auth-model": ["libs/auth/auth-model/src/index.ts"],
            "@matheportal/auth-data": ["libs/auth/auth-data/src/index.ts"],
            "@matheportal/auth-api": ["libs/auth/auth-api/src/index.ts"],
            "@matheportal/feedback-api": ["libs/feedback/feedback-api/src/index.ts"],
            "@matheportal/feedback-ui": ["libs/feedback/feedback-ui/src/index.ts"],
            "@matheportal/error-handling-api": ["libs/error-handling/error-handling-api/src/index.ts"],
            "@matheportal/error-and-feedback": ["libs/composition/error-and-feedback/src/index.ts"],
            "@matheportal/shared-utils": ["libs/shared-utils/shared-utils/src/index.ts"],
            "@matheportal/portal-navigation": ["libs/composition/portal-navigation/src/index.ts"]
        }
    },
    "exclude": ["node_modules", "tmp"]
}
