{
    "compileOnSave": false,
    "compilerOptions": {
        "rootDir": ".",
        "sourceMap": true,
        "declaration": false,
        "moduleResolution": "node",
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "importHelpers": true,
        "target": "es2015",
        "module": "esnext",
        "lib": ["es2020", "dom"],
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@mp-shell-config": ["./apps/matheportal-shell-ui/src/app/config/index.ts"],
            "@matheportal/shared-runtime-config": ["libs/shared-runtime-config/src/index.ts"],
            "@matheportal/shared-testing-ui": ["libs/shared-testing-ui/src/index.ts"],
            "@matheportal/auth-model": ["libs/auth/auth-model/src/index.ts"],
            "@matheportal/auth-data": ["libs/auth/auth-data/src/index.ts"],
            "@matheportal/auth-api": ["libs/auth/auth-api/src/index.ts"]
        }
    },
    "exclude": ["node_modules", "tmp"]
}
