{
    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#5470de",
        "activityBar.activeBorder": "#fa45d4",
        "activityBar.background": "#5470de",
        "activityBar.foreground": "#15202b",
        "activityBar.inactiveForeground": "#15202b99",
        "activityBarBadge.background": "#fa45d4",
        "activityBarBadge.foreground": "#15202b",
        "sash.hoverBorder": "#5470de",
        "statusBar.background": "#5470de",
        "statusBar.foreground": "#ffffff",
        "statusBarItem.hoverBackground": "#f4ca42",
        "statusBarItem.remoteBackground": "#5470de",
        "statusBarItem.remoteForeground": "#15202b",
        "titleBar.activeBackground": "#f4ca42",
        "titleBar.activeForeground": "#15202b",
        "titleBar.inactiveBackground": "#fcf47f",
        "titleBar.inactiveForeground": "#15202b99",
        "commandCenter.border": "#15202b99"
    },
    "files.exclude": {
        "**/.git": true,
        "**/dist": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/node_modules": true
    },
    "files.associations": {
        ".nxignore": "ignore"
    },
    "terminal.integrated.defaultProfile.linux": "bash",

    "java.jdt.ls.vmargs": "-javaagent:${userHome}/.m2/repository/org/projectlombok/lombok/1.18.42/lombok-1.18.42.jar -Xms2g -Xmx12g -XX:+UseG1GC -XX:+UseStringDeduplication",
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.autobuild.enabled": false,
    "java.compile.nullAnalysis.mode": "disabled",
    "java.import.maven.enabled": true,
    "java.import.maven.offline.enabled": true,
    "java.import.maven.disableTestClasspathFlag": true,
    "java.format.settings.url": "./.vscode/eclipse-java-formatter.xml",
    "java.format.settings.profile": "egladil",
    "[java]": {
        "editor.defaultFormatter": "redhat.java",
        "editor.formatOnSave": true,
        "editor.detectIndentation": false // Zwingt VS Code, nicht selbst zu "raten"
    },
    "xml.validation.enabled": false,
    "xml.format.enabled": true,
    "java.saveActions.cleanup": true,
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit"
    },
    "java.debug.settings.onBuildFailureProceed": true,
    "java.cleanup.actions": ["addFinalModifier"],
    "js/ts.tsdk.path": "node_modules/typescript/lib",
    "eslint.workingDirectories": [{ "mode": "auto" }],
    "eslint.run": "onSave",
    "eslint.probe": ["typescript", "typescriptreact", "javascript", "javascriptreact"],
    "coverage-gutters.coverageFileNames": ["jacoco.xml"]
}
